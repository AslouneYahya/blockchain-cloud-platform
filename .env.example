# =============================================================================
# .env.example — Blockchain Cloud Platform Environment Configuration
# =============================================================================

# Go Cluster Daemon & Smart Contract Gatekeeper
PORT=8080
DATA_DIR=/data
CLUSTER_TOTAL_RAM_MB=12288
K3S_NAMESPACE=default
CLUSTER_DOMAIN=cluster.local

# Optional Gatekeeper Permissions
ADMIN_WALLET=0x71C8364733184765ca4F4F7B3347b2c01d418290
ALLOWLIST_ONLY=false

# immudb Cryptographic Immutable Ledger
IMMUDB_HOST=immudb
IMMUDB_PORT=3322

# Kubernetes / K3s Configuration
# (Automatically detects in-cluster config or uses local kubeconfig if provided)
# KUBECONFIG=/etc/rancher/k3s/k3s.yaml
